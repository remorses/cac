{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "./esm",
        "rootDir": "./src",
        "noEmit": false,
        "declaration": true,
        "declarationMap": true,
        "composite": true,
        "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
        "types": ["@cloudflare/workers-types", "node", "vite/client"],
        "jsx": "react-jsx",
        "skipLibCheck": true,
        "lib": ["esnext", "dom"],
        "paths": {
            "plugin-mcp/*": ["./src/*"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "esm"]
}
