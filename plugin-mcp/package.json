{
    "name": "plugin-mcp",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "main": "./src/index.ts",
    "imports": {
        "#framer-client": {
            "types": "./src/lib/framer-client.ts",
            "browser": "./src/lib/framer-client.ts",
            "default": "./src/lib/framer-client.server.ts"
        }
    },
    "scripts": {
        "dev": "doppler run -c preview -- vite",
        "test": "doppler run -- pnpm vitest -u --run",
        "build": "tsc && rm -rf dist && doppler run -c production -- pnpm vite build",
        "pack": "pnpm build && pnpm gen-unframer && npx -y framer-plugin-tools@latest pack && open -R plugin.zip",
        "check": "pnpm tsc --incremental",
        "workshop.md": "jq -r '.' src/prompts/workshop.json > src/prompts/workshop.md",
        "typecheck": "pnpm tsc --noEmit --incremental",
        "secrets:preview": "doppler run -c preview --mount .env.preview --mount-format env -- wrangler secret bulk --env preview .env.preview",
        "secrets:prod": "doppler run -c production --mount .env.prod --mount-format env -- wrangler secret bulk .env.prod",
        "deployment:prod": "sudo echo 'agents should never run this' && pnpm typecheck && pnpm wrangler deploy --env='' && pnpm wrangler deploy --env preview",
        "deployment": "pnpm typecheck && pnpm wrangler deploy --env preview",
        "start": "vite preview --port 5173",
        "gen-client": "export DIR=../plugin-mcp/src/generated/ && cd ../website && tsc --incremental && cd ../plugin-mcp && rm -rf $DIR && mkdir -p $DIR && cp ../website/dist/src/lib/api-client.* $DIR",
        "gen-unframer": "rm -rf ../unframer/unframer/src/plugin-mcp-dist && mkdir -p ../unframer/unframer/src/plugin-mcp-dist && cp -r esm/lib ../unframer/unframer/src/plugin-mcp-dist/"
    },
    "dependencies": {
        "@cloudflare/workers-oauth-provider": "^0.0.11",
        "@modelcontextprotocol/sdk": "^1.25.3",
        "@sentry/browser": "^9.22.0",
        "agents": "0.4.0",
        "camelcase": "^8.0.0",
        "diff": "^7.0.0",
        "dom-serializer": "^2.0.0",
        "framer-api": "^0.1.1",
        "framer-plugin": "^3.10.3",
        "htmlparser2": "^9.1.0",
        "lucide-react": "^0.474.0",
        "plugin-mcp": "workspace:*",
        "plugin-migrate": "0.0.1-security",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-router": "^7.12.0",
        "react-router-dom": "^7.12.0",
        "react-use-measure": "^2.1.7",
        "sema4": "^0.1.3",
        "sentries": "^0.2.2",
        "spiceflow": "workspace:*",
        "string-dedent": "^3.0.1",
        "unframer": "workspace:*",
        "website": "workspace:*",
        "zod": "^4.3.6",
        "zustand": "^5.0.5"
    },
    "devDependencies": {
        "@types/node": "^20",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react-swc": "^3.8.1",
        "autoprefixer": "^10.4.20",
        "postcss": "^8.4.47",
        "tailwindcss": "^3.4.15",
        "typescript": "^5.5.3",
        "vite": "^6.3.5",
        "vite-plugin-environment": "^1.1.3",
        "vite-plugin-framer": "^1.0.7",
        "vite-plugin-mkcert": "^1.17.6",
        "vite-tsconfig-paths": "^5.1.4",
        "wrangler": "^4.26.0"
    }
}
