{
    "name": "plugin-mcp",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "main": "./src/index.ts",
    "scripts": {
        "dev": "doppler run -c production -- vite",
        "test": "doppler run -- pnpm vitest -u --run",
        "build": "tsc && rm -rf dist && NODE_ENV=production doppler run -c production -- vite build",
        "check": "pnpm tsc --incremental",
        "typecheck": "pnpm tsc --noEmit --incremental",
        "deployment": "pnpm wrangler deploy",
        "start": "vite preview --port 5173",
        "gen-client": "export DIR=../plugin-mcp/src/generated/ && cd ../website && tsc --incremental && cd ../plugin-mcp && rm -rf $DIR && mkdir -p $DIR && cp ../website/dist/src/lib/api-client.* $DIR"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.17.0",
        "@sentry/browser": "^9.22.0",
        "agents": "^0.0.109",
        "camelcase": "^8.0.0",
        "dom-serializer": "^2.0.0",
        "framer-plugin": "^3.5.2",
        "htmlparser2": "^9.1.0",
        "lucide-react": "^0.474.0",
        "plugin-mcp": "workspace:*",
        "plugin-migrate": "0.0.1-security",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-router": "^7.6.3",
        "react-router-dom": "^7.6.3",
        "react-use-measure": "^2.1.7",
        "sema4": "^0.1.3",
        "spiceflow": "workspace:*",
        "string-dedent": "^3.0.1",
        "unframer": "workspace:*",
        "website": "workspace:*",
        "zod": "^4.0.10",
        "zustand": "^5.0.5"
    },
    "devDependencies": {
        "@types/node": "^20",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.2",
        "@vitejs/plugin-react-swc": "^3.8.1",
        "autoprefixer": "^10.4.20",
        "postcss": "^8.4.47",
        "tailwindcss": "^3.4.15",
        "typescript": "^5.5.3",
        "vite": "^6.3.5",
        "vite-plugin-environment": "^1.1.3",
        "vite-plugin-framer": "^1.0.7",
        "vite-plugin-mkcert": "^1.17.6",
        "vite-tsconfig-paths": "^5.1.4",
        "wrangler": "^4.26.0"
    }
}
