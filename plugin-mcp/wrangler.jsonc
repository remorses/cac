/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "workers_dev": true, // <— this forces a Worker deploy to workers.dev

    "name": "framer-mcp-preview",
    "main": "src/worker.ts",
    "compatibility_date": "2025-07-10",
    "compatibility_flags": ["nodejs_compat"],
    "migrations": [
        {
            "new_sqlite_classes": ["MyMCP"],
            "tag": "v1",
        },
    ],
    "durable_objects": {
        "bindings": [
            {
                "class_name": "MyMCP",
                "name": "MCP_OBJECT",
            },
        ],
    },
    "kv_namespaces": [
        {
            "binding": "OAUTH_KV",
            "id": "df3f251b15b24a79bd8884a790386ba8",
        },
    ],
    "routes": [
        {
            "zone_name": "unframer.co",
            "pattern": "mcp.unframer.co",
            "custom_domain": true,
        },
    ],
    "rules": [
        {
            "type": "Text",
            "globs": ["*.md"],
            "fallthrough": true,
        },
    ],

    "observability": {
        "enabled": true,
    },

    // Production environment variables
    "vars": {
        "STAGE": "production",
        "WEBSITE_URL": "https://unframer.co",
    },

    // Preview environment configuration
    "env": {
        "preview": {
            "name": "framer-mcp-preview-preview",
            "vars": {
                "STAGE": "preview",
                "WEBSITE_URL": "https://preview.unframer.co",
            },
            "routes": [
                {
                    "zone_name": "unframer.co",
                    "pattern": "mcp.preview.unframer.co",
                    "custom_domain": true,
                },
            ],
            "kv_namespaces": [
                {
                    "binding": "OAUTH_KV",
                    "id": "93005a9f4a064b809763718cac256a7d",
                },
            ],
            "durable_objects": {
                "bindings": [
                    {
                        "class_name": "MyMCP",
                        "name": "MCP_OBJECT",
                    },
                ],
            },
        },
    },
}
