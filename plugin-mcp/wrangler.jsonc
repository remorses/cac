/**
 * Framer MCP v2 — lightweight worker + tunnel DO (no agents package).
 * Uses new DO class McpTunnel (old MyMCP DOs stay untouched and can be cleaned up separately).
 *
 * Production deployment steps (run in order):
 *
 * Step 1 — Deploy fumabase tunnel to prod (removes unframer.co routes):
 *   cd /Users/morse/Documents/GitHub/fumabase/cloudflare-tunnel && pnpm deployment:prod
 *   (already committed: unframer.co/_tunnel/* and mcp.unframer.co/_tunnel/* routes removed)
 *
 * Step 2 — Deploy this MCP worker to prod (takes over those routes):
 *   cd /Users/morse/Documents/GitHub/unframer-private/plugin-mcp && pnpm deployment:prod
 *   This deploys framer-mcp-preview with McpTunnel DO + unframer.co/_tunnel/* route.
 *
 * Step 3 — Verify:
 *   - Open Framer plugin in a project, check green dot (plugin WS connects via unframer.co/_tunnel)
 *   - Use MCP client (Claude/Cursor) with mcp.unframer.co/mcp URL, call a tool
 *   - No plugin rebuild needed — same wss://unframer.co/_tunnel/upstream URL as before
 *
 * Step 4 — Cleanup:
 *   - Delete old framer-mcp-v2 worker from Cloudflare dashboard (leftover test worker)
 *   - Remove TODO comments from this file and fumabase wrangler.jsonc
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "workers_dev": true,

    "name": "framer-mcp-preview",
    "main": "src/worker.ts",
    "compatibility_date": "2025-07-10",
    "compatibility_flags": ["nodejs_compat"],
    "migrations": [
        {
            "new_sqlite_classes": ["MyMCP"],
            "tag": "v1",
        },
        {
            "new_classes": ["McpTunnel"],
            "deleted_classes": ["MyMCP"],
            "tag": "v2",
        },
    ],
    "durable_objects": {
        "bindings": [
            {
                "class_name": "McpTunnel",
                "name": "MCP_TUNNEL",
            },
        ],
    },
    "ratelimits": [
        {
            "name": "RATE_LIMITER",
            "namespace_id": "1001",
            "simple": {
                "limit": 500,
                "period": 60,
            },
        },
    ],
    "kv_namespaces": [
        {
            "binding": "SESSION_KV",
            "id": "df3f251b15b24a79bd8884a790386ba8",
        },
    ],
    "routes": [
        {
            "zone_name": "unframer.co",
            "pattern": "mcp.unframer.co",
            "custom_domain": true,
        },
        // Plugin connects to wss://unframer.co/_tunnel/upstream — handle it here
        // so the upstream WS lands in the same McpTunnel DO that handles MCP requests.
        {
            "pattern": "unframer.co/_tunnel/*",
            "zone_name": "unframer.co",
        },
    ],
    "rules": [
        {
            "type": "Text",
            "globs": ["*.md"],
            "fallthrough": true,
        },
    ],

    "observability": {
        "logs": {
            "enabled": true,
            "head_sampling_rate": 0.1,
            "invocation_logs": true,
        },
        "traces": {
            "enabled": false,
        },
    },

    // Production environment variables
    "vars": {
        "STAGE": "production",
        "WEBSITE_URL": "https://unframer.co",
    },

    // Preview environment configuration
    "env": {
        "preview": {
            "name": "framer-mcp-preview-preview",
            "vars": {
                "STAGE": "preview",
                "WEBSITE_URL": "https://preview.unframer.co",
            },
            "routes": [
                {
                    "zone_name": "unframer.co",
                    "pattern": "mcp.preview.unframer.co",
                    "custom_domain": true,
                },
                {
                    "pattern": "preview.unframer.co/_tunnel/*",
                    "zone_name": "unframer.co",
                },
            ],
            "ratelimits": [
                {
                    "name": "RATE_LIMITER",
                    "namespace_id": "1001",
                    "simple": {
                        "limit": 500,
                        "period": 60,
                    },
                },
            ],
            "kv_namespaces": [
                {
                    "binding": "SESSION_KV",
                    "id": "93005a9f4a064b809763718cac256a7d",
                },
            ],
            "durable_objects": {
                "bindings": [
                    {
                        "class_name": "McpTunnel",
                        "name": "MCP_TUNNEL",
                    },
                ],
            },
        },
    },
}
