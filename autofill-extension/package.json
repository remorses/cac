{
    "name": "autofill-extension",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "doppler run -- vite",
        "check": "pnpm tsc --incremental",
        "copy-plugin": "export OUT=../website/public/ && mkdir -p $OUT && cp -r ./dist/ $OUT",
        "build": "tsc && rm -rf dist && NODE_ENV=production doppler run -c production -- vite build && pnpm copy-plugin",
        "deployment_": "pnpm build && pnpm wrangler pages deploy dist",
        "preview": "vite preview"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^0.0.41",
        "@ai-sdk/openai": "^0.0.46",
        "@crxjs/vite-plugin": "2.0.0-beta.25",
        "spiceflow": "workspace:*",
        "@headlessui/tailwindcss": "^0.2.1",
        "@sentry/browser": "^8.19.0",
        "@sinclair/typebox": "^0.32.34",
        "@sindresorhus/slugify": "^2.2.1",
        "@supabase/supabase-js": "^2.44.4",
        "@tailwindcss/forms": "^0.5.7",
        "ai": "^3.3.7",
        "classnames": "^2.5.1",
        "db": "workspace:^",
        
        "eventsource-parser": "^1.1.2",
        "framer-motion": "^11.3.8",
        "is-hotkey": "0.2.0",
        "isbot": "^4.4.0",
        "nextjs-progressbar": "^0.0.16",
        "nprogress": "^0.2.0",
        "openai": "^4.52.7",
        "preact": "^10.23.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router": "^6.25.1",
        "react-router-dom": "^6.25.1",
        "react-use-measure": "^2.1.1",
        "tailwindcss": "^3.4.6",
        "vite-plugin-environment": "^1.1.3",
        "vite-plugin-mkcert": "^1.17.5",
        "vite-tsconfig-paths": "^4.3.2",
        "website": "workspace:^",
        "zustand": "^4.5.4"
    },
    "devDependencies": {
        "@types/chrome": "^0.0.269",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.1",
        "@vitejs/plugin-react-swc": "^3.7.0",
        "vite": "^5.4.0",
        "vite-plugin-framer": "^0.0.10"
    }
}
