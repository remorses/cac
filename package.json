{
    "name": "root",
    "private": true,
    "scripts": {
        "test": "NODE_ENV=test pnpm -r --filter='!*spiceflow*' test",
        "bootstrap": "pnpm --parallel --filter spiceflow build && pnpm --filter db gen",
        "typecheck": "pnpm --filter spiceflow build && pnpm -r --filter '!spiceflow' --parallel --no-bail typecheck",
        "build": "pnpm -r build",
        "release": "git merge main && git checkout main && git merge preview && git push && git checkout preview"
    },
    "workspaces": [
        "./*",
        "./unframer/*",
        "./spiceflow/*"
    ],
    "pnpm": {
        "overrides": {}
    },
    "devDependencies": {
        "@changesets/cli": "^2.27.12",
        "@prisma/client": "^6.14.0",
        "prettier": "^3.4.2",
        "tsx": "^4.20.3",
        "typescript": "^5.8.3",
        "vite": "^6.3.5",
        "vitest": "^3.1.4"
    },
    "packageManager": "pnpm@10.14.0",
    "repository": "https://github.com/remorses/",
    "author": "remorses <beats.by.morse@gmail.com>",
    "license": "",
    "dependencies": {
        "rollup-plugin-visualizer": "^5.14.0",
        "zod": "^4.1.1",
        "zod-validation-error": "^4.0.1"
    }
}
