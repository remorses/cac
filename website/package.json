{
    "name": "website",
    "private": true,
    "sideEffects": false,
    "scripts": {
        "typecheck": "pnpm tsc --noEmit --incremental",
        "build": "NODE_ENV=production doppler run -c production -- pnpm concurrently 'pnpm remix vite:build' 'pnpm tsc' && pnpm copy-prisma",
        "prebuild": "pnpm --filter spiceflow build",
        "fly": "fly --app unframer-website-prod",
        "deployment": "doppler run -- pnpm tsx -C import scripts/deployment.ts",
        "check": "pnpm tsc --incremental",
        "openapi": "doppler run -- pnpm tsx -C import scripts/openapi.tsx",
        "gen-client": "export DIR=../unframer/unframer/src/generated/ && tsc --incremental && rm -rf $DIR && mkdir -p $DIR && cp dist/lib/api-client.* $DIR",
        "cleanup": "pnpx @line/ts-remove-unused --check --skip '/routes/' --skip /\\.test/ --skip /framer/ --skip entry\\. --skip '/root\\.'",
        "copy-prisma": "cp ../db/schema.prisma ./build/",
        "prisma-gen": "pnpm copy-prisma && pnpm prisma  generate --schema ../db/schema.prisma",
        "test": "doppler run -- vitest",
        "tunnel": "echo 'listening to https://tunnel.unframer.co' && cloudflared tunnel run --url http://localhost:8040 unframer-local",
        "tunnel-token": "cloudflared tunnel token --cred-file ~/.cloudflared/bcb47212-d8bc-49cb-8f05-eb66f280f76e.json unframer-local",
        "test:prod": "doppler run -c production -- vitest -u",
        "dev": "doppler run -- remix vite:dev -p 8040",
        "serve-plugin": "serve public --cors --ssl-cert localhost.pem --ssl-key localhost-key.pem",
        "dev:prod": "doppler run -c production -- remix vite:dev -p 8040",
        "start": "PORT=8040 doppler run --command 'pnpm remix-serve-but-not-shit ./build/server/index.js'"
    },
