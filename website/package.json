{
    "name": "website",
    "private": true,
    "sideEffects": false,
    "scripts": {
        "build": "NODE_ENV=production doppler run -- pnpm concurrently 'pnpm remix vite:build' 'pnpm tsc' && pnpm copy-prisma",
        "fly": "fly --app unframer-website-prod",
        "deployment": "pnpm tsx scripts/deployment.ts",
        "check": "pnpm tsc --incremental",
        "copy-prisma": "cp ../db/schema.prisma ./build/",
        "gen-client": "export DIR=../crisp-raycast/src/generated/ && rm -rf dist && tsc && rm -rf $DIR && mkdir -p $DIR && cp dist/lib/client.* $DIR",
        "test": "doppler run -- vitest",
        "tunnel": "echo 'listening to https://tunnel.unframer.co' && cloudflared tunnel run --url http://localhost:8040 unframer-local",
        "tunnel-token": "cloudflared tunnel token --cred-file ~/.cloudflared/bcb47212-d8bc-49cb-8f05-eb66f280f76e.json unframer-local",
        "test:prod": "doppler run -c production -- vitest -u",
        "dev": "doppler run -- remix vite:dev -p 8040",
        "serve-plugin": "serve public --cors --ssl-cert localhost.pem --ssl-key localhost-key.pem",
        "dev:prod": "doppler run -c production -- remix vite:dev -p 8040",
        "start": "PORT=8040 doppler run -- remix-serve ./build/server/index.js"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^0.0.41",
        "@ai-sdk/openai": "^0.0.46",
        "@elysiajs/cors": "^1.1.0",
        "@elysiajs/eden": "github:remorses/elysia-eden#dist",
        "@elysiajs/static": "^1.1.0",
        "@elysiajs/stream": "^1.1.0",
        "@elysiajs/swagger": "^1.1.0",
        "@lemonsqueezy/lemonsqueezy.js": "^3.2.0",
        "@nextui-org/react": "2.4.2",
        "@nextui-org/theme": "^2.2.6",
        "@octokit/webhooks": "^13.3.0",
        "@prisma/client": "^5.17.0",
        "@remix-run/node": "2.11.1",
        "@remix-run/react": "2.11.1",
        "@remix-run/serve": "2.11.1",
        "@sentry/node": "^8.17.0",
        "@sinclair/typebox": "^0.32.34",
        "@supabase/ssr": "^0.3.0",
        "@supabase/supabase-js": "^2.44.4",
        "@tailwindcss/forms": "^0.5.7",
        "@tailwindcss/typography": "^0.5.13",
        "@types/marked": "^6.0.0",
        "@xmorse/deployment-utils": "^0.2.5",
        "ai": "^3.3.7",
        "async-sema": "^3.1.1",
        "clsx": "^2.1.1",
        "concurrently": "^8.2.2",
        "db": "workspace:*",
        "dedent": "^1.5.3",
        "elysia": "github:remorses/elysia#dist",
        "event-iterator": "^2.0.0",
        "fast-xml-parser": "^4.4.0",
        "gray-matter": "^4.0.3",
        "htmlrewriter": "^0.0.9",
        "input-otp": "^1.2.4",
        "is-valid-domain": "^0.1.6",
        "isbot": "^5.1.13",
        "lemonsqueezy-webhooks": "^0.1.2",
        "lucide-react": "^0.395.0",
        "marked": "^13.0.2",
        "ndjson": "^2.0.0",
        "nprogress": "^0.2.0",
        "octokit": "^4.0.2",
        "openai": "^4.52.7",
        "papaparse": "^5.4.1",
        "picocolors": "^1.0.1",
        "posthtml": "^0.16.6",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-hot-toast": "^2.4.1",
        "remix-serve-but-not-shit": "workspace:*",
        "rollup-plugin-visualizer": "^5.12.0",
        "screenshotone-api-sdk": "^1.1.11",
        "sharp": "^0.33.4",
        "spiceflow": "^1.0.0",
        "strip-json-comments": "^5.0.1",
        "tailwindcss": "^3.4.5",
        "unframer": "workspace:*",
        "vite-plugin-inspect": "^0.8.4",
        "website": "workspace:*",
        "zod": "^3.23.8",
        "zod-form-data": "^2.0.2",
        "zod-validation-error": "^3.3.0"
    },
    "devDependencies": {
        "@remix-run/dev": "2.11.1",
        "@types/node": "^20.14.10",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "vite": "^5.4.0",
        "vite-plugin-environment": "^1.1.3",
        "vite-tsconfig-paths": "^4.3.2"
    },
    "engines": {
