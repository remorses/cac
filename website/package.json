{
    "name": "website",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "scripts": {
        "typecheck": "pnpm react-router typegen && pnpm tsc --noEmit --incremental",
        "build": "NODE_ENV=production NODE_OPTIONS='--max-old-space-size=8192' doppler run -c production -- pnpm concurrently 'pnpm react-router build' 'pnpm tsc'",
        "prebuild": "pnpm --filter spiceflow build",
        "fly:prod": "fly --app unframer-website-prod",
        "fly:preview": "fly --app unframer-website-preview",
        "deployment": "doppler run -- pnpm vite-node scripts/deployment.ts",
        "deployment:prod": "STAGE=production doppler run -- pnpm vite-node scripts/deployment.ts",
        "check": "pnpm tsc --incremental",
        "typegen": "pnpm react-router typegen",
        "framer": "pnpm unframer --outDir src/framer 620e74c088cdcb26",
        "openapi": "doppler run -- pnpm tsx -C import scripts/openapi.tsx",
        "gen-client": "export DIR=../unframer/unframer/src/generated/ && tsc --incremental; rm -rf $DIR && mkdir -p $DIR && cp dist/src/lib/api-client.* $DIR",
        "cleanup": "pnpx @line/ts-remove-unused --check --skip '/routes/' --skip /\\.test/ --skip /framer/ --skip entry\\. --skip '/root\\.'",
        "test": "doppler run -c dev -- vitest",
        "tunnel": "echo 'listening to https://tunnel.unframer.co' && cloudflared tunnel run --url http://localhost:8040 unframer-local",
        "tunnel-token": "cloudflared tunnel token --cred-file ~/.cloudflared/bcb47212-d8bc-49cb-8f05-eb66f280f76e.json unframer-local",
        "test:prod": "doppler run -c production -- vitest -u",
        "dev": "doppler run -- react-router dev -p 8040",
        "serve-plugin": "serve public --cors --ssl-cert localhost.pem --ssl-key localhost-key.pem",
        "dev:prod": "doppler run -c production -- react-router dev -p 8040",
        "start": "PORT=8040 doppler run --command 'node ./build/server/server.js'"
    },
