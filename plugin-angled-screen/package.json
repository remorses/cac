{
    "name": "plugin-angled-screen",
    "private": true,
    "type": "module",
    "main": "src/api/index.ts",
    "scripts": {
        "dev": "doppler run -- vite",
        "build": "tsc && rm -rf dist && NODE_ENV=production doppler run -c production -- vite build ",
        "format": "prettier . --write",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "start": "vite preview --port 5173",
        "typecheck": "pnpm tsc --noEmit --incremental"
    },
    "dependencies": {
        "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
        "@types/three": "^0.172.0",
        "colord": "^2.9.3",
        "framer-motion": "^12.23.12",
        "framer-plugin": "^3.6.0",
        "plugin-migrate": "workspace:^",
        "postcss": "8.5.1",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-router": "^7.9.3",
        "react-router-dom": "^7.9.3",
        "react-use-measure": "^2.1.7",
        "spiceflow": "workspace:*",
        "tailwindcss": "^3.4.6",
        "three": "^0.172.0",
        "vite-plugin-environment": "^1.1.3",
        "vite-plugin-mkcert": "^1.17.6",
        "vite-tsconfig-paths": "^5.1.4",
        "website": "workspace:^"
    },
    "devDependencies": {
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.2",
        "@vitejs/plugin-react-swc": "^3.8.1",
        "vite": "^6.3.5",
        "vite-plugin-framer": "^1.0.7"
    }
}
