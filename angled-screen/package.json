{
    "name": "angled-screen",
    "private": true,
    "type": "module",
    "main": "src/api/index.ts",
    "scripts": {
        "dev": "doppler run -- vite",
        "build": "tsc && rm -rf dist && NODE_ENV=production doppler run -c production -- vite build ",
        "format": "prettier . --write",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "typecheck": "pnpm tsc --noEmit --incremental"
    },
    "dependencies": {
        "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
        "@types/three": "^0.172.0",
        "colord": "^2.9.3",
        "framer-motion": "^12.0.6",
        "framer-plugin": "2.1.0",
        "postcss": "8.5.1",
        "react": "19.0.0",
        "react-dom": "19.0.0",
        "react-router": "^7.1.5",
        "react-router-dom": "^7.1.5",
        "react-use-measure": "^2.1.1",
        "spiceflow": "^1.6.1",
        "tailwindcss": "^3.4.6",
        "template-rewrite-framer": "workspace:^",
        "website": "workspace:^",
        "three": "^0.172.0",
        "three-soft-depth-of-field": "workspace:^",
        "vite-plugin-environment": "^1.1.3",
        "vite-plugin-mkcert": "^1.17.6",
        "vite-tsconfig-paths": "^5.1.4"
    },
    "devDependencies": {
        "@types/react": "^19.0.8",
        "@types/react-dom": "^19.0.3",
        "@vitejs/plugin-react-swc": "^3.7.2",
        "vite": "^6.0.11",
        "vite-plugin-framer": "^1.0.3"
    }
}
