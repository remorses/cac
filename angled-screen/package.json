{
    "name": "angled-screen",
    "private": true,
    "type": "module",
    "main": "src/api/index.ts",
    "scripts": {
        "dev": "doppler run -- vite",
        "build": "tsc && rm -rf dist && NODE_ENV=production doppler run -c production -- vite build ",
        "format": "prettier . --write",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "typecheck": "pnpm tsc --noEmit --incremental"
    },
    "dependencies": {
        "@lemonsqueezy/lemonsqueezy.js": "^3.2.0",
        "@types/three": "^0.168.0",
        "colord": "^2.9.3",
        "framer-motion": "^11.11.17",
        "framer-plugin": "2.1.0-beta.1",
        "postcss": "8.4.24",
        "react": "19.0.0-rc-e4953922-20240919",
        "react-dom": "19.0.0-rc-e4953922-20240919",
        "react-router": "^6.25.1",
        "react-router-dom": "^6.25.1",
        "react-use-measure": "^2.1.1",
        "tailwindcss": "^3.4.10",
        "template-rewrite-framer": "workspace:^",
        "three": "^0.168.0",
        "vite-plugin-environment": "^1.1.3",
        "vite-plugin-mkcert": "^1.17.5",
        "vite-tsconfig-paths": "^4.3.2"
    },
    "devDependencies": {
        "@types/react": "^18.3.5",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react-swc": "^3.6.0",
        "vite": "^5.4.11",
        "vite-plugin-framer": "^0.0.10"
    }
}
