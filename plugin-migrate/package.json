        "@types/textarea-caret": "^3.0.4",
        "ai": "^4.3.15",
        "classnames": "^2.5.1",
        "db": "workspace:^",
        "es-module-shims": "^2.0.9",
        "eventsource-parser": "^3.0.0",
        "framer-motion": "^12.0.6",
